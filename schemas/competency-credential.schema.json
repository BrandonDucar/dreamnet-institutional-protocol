{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dreamnet.ink/institutional/competency-credential.v1.json",
  "title": "DreamNet Competency Credential v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "credentialId",
    "issuerId",
    "subjectAgentId",
    "capability",
    "level",
    "status",
    "validFrom",
    "validUntil",
    "evidence",
    "standards",
    "integrity"
  ],
  "properties": {
    "schemaVersion": {
      "const": "dreamnet.competency.v1"
    },
    "credentialId": {
      "type": "string",
      "minLength": 1
    },
    "issuerId": {
      "type": "string",
      "minLength": 1
    },
    "subjectAgentId": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "const": "proctored-field-mastery"
    },
    "status": {
      "enum": [
        "active",
        "suspended",
        "revoked",
        "expired"
      ]
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workoutReceiptDigests",
        "fieldExam"
      ],
      "properties": {
        "workoutReceiptDigests": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "fieldExam": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receiptDigest",
            "reviewerId",
            "reviewerOrganization",
            "independentlyAttested",
            "passed"
          ],
          "properties": {
            "receiptDigest": {
              "$ref": "#/$defs/digest"
            },
            "reviewerId": {
              "type": "string",
              "minLength": 1
            },
            "reviewerOrganization": {
              "type": "string",
              "minLength": 1
            },
            "independentlyAttested": {
              "const": true
            },
            "passed": {
              "const": true
            }
          }
        }
      }
    },
    "standards": {
      "type": "array",
      "contains": {
        "const": "toolgym"
      }
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "integrity": {
      "type": "object",
      "required": [
        "canonicalization",
        "digest"
      ],
      "properties": {
        "canonicalization": {
          "const": "dreamnet.sorted-json.v1"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
